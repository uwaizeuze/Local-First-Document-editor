# ─── Database ─────────────────────────────────────────────────
# A local Postgres example for development:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/doceditor
DATABASE_URL="postgresql://postgres:password@localhost:5432/doceditor"

# ─── NextAuth ─────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Legacy fallback for older config
AUTH_SECRET=$NEXTAUTH_SECRET
AUTH_URL=$NEXTAUTH_URL

# ─── Google OAuth (optional) ──────────────────────────────────
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ─── WebSocket server (y-websocket) ───────────────────────────
NEXT_PUBLIC_WS_URL=ws://localhost:1234
WS_PORT=1234
WS_SECRET=your-ws-secret-key

# ─── AI Assistant (optional) ──────────────────────────────────
# Supports Groq or OpenAI. Set AI_PROVIDER to "groq" or "openai".
# Groq (free tier available): https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

AI_PROVIDER=groq

# ─── Rate limiting ────────────────────────────────────────────
SYNC_RATE_LIMIT_PER_MINUTE=120

# ─── Email (Resend) ───────────────────────────────────────────
# Get your free API key at https://resend.com (100 emails/day free)
# Without this key emails are silently skipped — app still works.
RESEND_API_KEY=re_your_resend_api_key_here

# The "From" address shown in emails.
# Must be a verified domain in your Resend account.
# Use Resend's sandbox address for local testing: onboarding@resend.dev
EMAIL_FROM="DocEditor <noreply@yourdomain.com>"
