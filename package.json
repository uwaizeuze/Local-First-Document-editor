{
  "name": "local-first-document-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first collaborative document editor with CRDT sync, offline support, and version history",
  "scripts": {
    "dev": "concurrently \"next dev\" \"npm run ws:dev\"",
    "dev:next": "next dev",
    "ws:dev": "tsx watch server/ws-server.ts",
    "build": "next build",
    "start": "next start",
    "ws:start": "tsx server/ws-server.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.16",
    "@auth/drizzle-adapter": "^1.9.0",
    "@blocknote/core": "^0.31.0",
    "@blocknote/mantine": "^0.31.0",
    "@blocknote/react": "^0.31.0",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@tanstack/react-query": "^5.74.4",
    "ai": "^4.3.10",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.43.0",
    "idb": "^8.0.2",
    "lib0": "^0.2.100",
    "lucide-react": "^0.503.0",
    "next": "^16.2.0",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.80.0",
    "resend": "^6.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.2.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.25.1",
    "eslint-config-next": "^16.2.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
